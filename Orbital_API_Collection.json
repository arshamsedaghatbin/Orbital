{
	"info": {
		"_postman_id": "orbital-trading-api-v1-1",
		"name": "Orbital Trading API v1.1",
		"description": "Professional REST Collection for Orbital Engine with full DTO support.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				},
				{
					"name": "System Status (DTO)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/system/status",
							"host": ["{{baseUrl}}"],
							"path": ["system", "status"]
						},
						"description": "Returns consolidated engine, ai, and history status."
					}
				},
				{
					"name": "Rebuild Vector Index",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/system/vector-rebuild",
							"host": ["{{baseUrl}}"],
							"path": ["system", "vector-rebuild"]
						}
					}
				}
			]
		},
		{
			"name": "Market & Account",
			"item": [
				{
					"name": "Get Account Metrics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/account",
							"host": ["{{baseUrl}}"],
							"path": ["account"]
						}
					}
				},
				{
					"name": "Get Active Trades/Orders",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/trades",
							"host": ["{{baseUrl}}"],
							"path": ["trades"]
						}
					}
				}
			]
		},
		{
			"name": "Operations",
			"item": [
				{
					"name": "Execute Signal (DTO)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"XAUUSD BUY 2500.0 SL 2480.0\",\n    \"source\": \"Postman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/signal",
							"host": ["{{baseUrl}}"],
							"path": ["signal"]
						}
					}
				},
				{
					"name": "Close/Cancel Trade",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/trade/1234567",
							"host": ["{{baseUrl}}"],
							"path": ["trade", "1234567"]
						}
					}
				},
				{
					"name": "Cancel All Trades",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/trades?symbol=XAUUSD",
							"host": ["{{baseUrl}}"],
							"path": ["trades"],
							"query": [
								{
									"key": "symbol",
									"value": "XAUUSD"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Configuration",
			"item": [
				{
					"name": "Get Current Settings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						}
					}
				},
				{
					"name": "Update Risk Settings (DTO)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"risk_usd\": 100.0,\n    \"rr_target\": 6.0,\n    \"be_rr\": 1.5,\n    \"partial_rr\": 4.0,\n    \"partial_percent\": 0.5\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000"
		}
	]
}
