{
	"info": {
		"_postman_id": "orbital-trading-api-collection",
		"name": "Orbital Trading API",
		"description": "Standard REST Collection for the Orbital MT5 Signal Processing Engine",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Service Root",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						}
					}
				},
				{
					"name": "System Status",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/system/status",
							"host": ["{{baseUrl}}"],
							"path": ["system", "status"]
						}
					}
				},
				{
					"name": "Rebuild Vector Index",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/system/vector-rebuild",
							"host": ["{{baseUrl}}"],
							"path": ["system", "vector-rebuild"]
						}
					}
				},
				{
					"name": "Factory Reset",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/system/factory-reset",
							"host": ["{{baseUrl}}"],
							"path": ["system", "factory-reset"]
						},
						"description": "🧨 DANGER: Wipes all credentials and sessions."
					}
				}
			]
		},
		{
			"name": "Trading",
			"item": [
				{
					"name": "Get Account Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/account",
							"host": ["{{baseUrl}}"],
							"path": ["account"]
						}
					}
				},
				{
					"name": "Get Active Trades",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/trades",
							"host": ["{{baseUrl}}"],
							"path": ["trades"]
						}
					}
				},
				{
					"name": "Execute Signal",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"XAUUSD BUY 2500 SL 2480\",\n    \"source\": \"Postman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/signal",
							"host": ["{{baseUrl}}"],
							"path": ["signal"]
						}
					}
				},
				{
					"name": "Cancel All Trades",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/trades?symbol=XAUUSD",
							"host": ["{{baseUrl}}"],
							"path": ["trades"],
							"query": [
								{
									"key": "symbol",
									"value": "XAUUSD"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Configuration",
			"item": [
				{
					"name": "Get Settings",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						}
					}
				},
				{
					"name": "Update Settings",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"risk_usd\": 100,\n    \"rr_target\": 10.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000"
		}
	]
}
